{
  "name": "Asistente de Voz y Procesamiento IA - Full App Manager",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fonoaudio-voice-assistant",
        "options": {},
        "responseMode": "responseNode",
        "responseData": "all"
      },
      "id": "webhook-post",
      "name": "Webhook Voice POST",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "httpMethod": "OPTIONS",
        "path": "fonoaudio-voice-assistant",
        "options": {}
      },
      "id": "webhook-options",
      "name": "Webhook Voice OPTIONS (CORS)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
              { "name": "Access-Control-Allow-Headers", "value": "Content-Type" }
            ]
          }
        }
      },
      "id": "respond-options",
      "name": "Respond CORS Options",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [300, 100]
    },
    {
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "Eres Jarvis, el asistente de IA clínico experto de FonoAudio-Pro. Responde de forma clara, profesional y conversacional en español."
        }
      },
      "id": "agent-node",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {},
      "id": "memory-node",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1,
      "position": [550, 500]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=JSON.stringify({ response: $json.output || 'No se genero respuesta' })",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      },
      "id": "respond-node",
      "name": "Respond to Webhook POST",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Webhook Voice POST": {
      "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]]
    },
    "Webhook Voice OPTIONS (CORS)": {
      "main": [[{ "node": "Respond CORS Options", "type": "main", "index": 0 }]]
    },
    "AI Agent": {
      "main": [[{ "node": "Respond to Webhook POST", "type": "main", "index": 0 }]]
    },
    "Window Buffer Memory": {
      "ai_memory": [[{ "node": "AI Agent", "type": "ai_memory", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
