{
  "name": "Integración NotebookLM y Búsqueda",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notebooklm-webhook",
        "options": {}
      },
      "id": "node-1",
      "name": "Webhook NotebookLM",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 250, 300 ],
      "webhookId": "notebooklm-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.event }}",
              "value2": "notebooklm_add_note"
            }
          ]
        }
      },
      "id": "node-2",
      "name": "Check Event Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Nota agregada exitosamente al cuaderno {{ $json.body.notebook_id }}\"\n}",
        "options": {}
      },
      "id": "node-3",
      "name": "Respond Add Note",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [ 700, 200 ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"results\": [\n    {\n      \"title\": \"Evidencia sobre {{ $json.body.query }}\",\n      \"evidence\": \"Estudios recientes indican que...\",\n      \"foundation\": \"Base clínica de NotebookLM\",\n      \"obsidianLink\": \"FonoPro://Clinica/Notas.md\",\n      \"source\": \"Cuaderno: {{ $json.body.notebook_id }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "node-4",
      "name": "Respond Query",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [ 700, 400 ]
    }
  ],
  "connections": {
    "Webhook NotebookLM": {
      "main": [
        [
          {
            "node": "Check Event Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Event Type": {
      "main": [
        [
          {
            "node": "Respond Add Note",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0"
}
