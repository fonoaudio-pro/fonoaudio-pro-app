# FonoAudio-Pro AI Configuration

# --- Server ---
PORT=3001
VITE_BACKEND_URL=http://localhost:3001

# --- Supabase (Optional, for production) ---
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Telegram Bot (for proactive alerts) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Obsidian (for clinical notes export) ---
VITE_OBSIDIAN_URL=https://127.0.0.1:27124/
VITE_OBSIDIAN_API_KEY=your_obsidian_api_key
OBSIDIAN_URL=http://127.0.0.1:27123
OBSIDIAN_API_KEY=your_obsidian_api_key

# --- Google Workspace API (for Calendar & Meet) ---
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CLIENT_EMAIL=your_service_account_email.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your_private_key_here_replace_newlines_with_\n
GOOGLE_CALENDAR_ID=primary

# --- Google Drive (for Materials Library sync) ---
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_optional

# --- Groq API (for STT/LLM) ---
GROQ_API_KEY=your_groq_api_key

# --- Gemini API (for transcription & OCR) ---
GOOGLE_API_KEY_GEMINI=your_gemini_api_key

# --- Pexels (for image search in Multimedia Editor) ---
PEXELS_API_KEY=your_pexels_api_key

# --- Icons8 (for illustrations/cartoon/3D in Multimedia Editor) ---
ICONS8_API_KEY=your_icons8_api_key

# --- Web Push (NOTIFICACIONES PUSH WEB de la mascota) ---
# VAPID public key (no es secreto, puede estar en .env.example / frontend).
# La PRIVATE key es secreto: setearla SOLO como env var en Vercel (.env.local, NO commitear).
VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key  # <-- SECRET: configurar en Vercel env vars, nunca en repo
