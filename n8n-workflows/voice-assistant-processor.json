{
  "name": "Asistente de Voz y Procesamiento IA - Avanzado",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fonoaudio-voice-assistant",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook Voice",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 100, 300 ],
      "webhookId": "voice-assistant-webhook"
    },
    {
      "parameters": {
        "model": "gemini-1.5-pro-latest",
        "prompt": "={{ $json.body.text }}",
        "systemMessage": "Eres Jarvis, el asistente de IA clínico experto de FonoAudio-Pro. Tu objetivo es interactuar con el fonoaudiólogo de manera natural, conversacional y eficiente. El usuario ha dicho: '{{ $json.body.text }}'. Genera una respuesta útil, corta y directa que pueda ser leída en voz alta por el sistema de Text-to-Speech."
      },
      "id": "gemini-node",
      "name": "Google Gemini",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [ 400, 300 ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"response\": \"{{ $json.response }}\"\n}",
        "options": {}
      },
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [ 700, 300 ]
    }
  ],
  "connections": {
    "Webhook Voice": {
      "main": [
        [
          {
            "node": "Google Gemini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "2.0"
}
