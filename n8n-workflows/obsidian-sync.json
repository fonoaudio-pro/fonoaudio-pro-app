{
  "name": "Sincronización Obsidian",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fonoaudio-obsidian",
        "options": {}
      },
      "id": "obsidian-1",
      "name": "Webhook Obsidian",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 250, 300 ],
      "webhookId": "obsidian-webhook"
    },
    {
      "parameters": {
        "content": "## Informe Clínico\n\nPaciente: {{ $json.body.patientName }}\nFecha: {{ $json.body.date }}\n\n### Resumen\n{{ $json.body.summary }}\n\n### Plan Terapéutico\n{{ $json.body.plan }}",
        "options": {}
      },
      "id": "obsidian-2",
      "name": "Generar Markdown",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://your-obsidian-local-api:27123/vault/{{ $json.body.patientName | replace(' ', '_') }}.md",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_OBSIDIAN_LOCAL_REST_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "text/markdown"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.content }}",
        "options": {}
      },
      "id": "obsidian-3",
      "name": "Enviar a Obsidian Local REST API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 650, 300 ]
    }
  ],
  "connections": {
    "Webhook Obsidian": {
      "main": [
        [
          {
            "node": "Generar Markdown",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generar Markdown": {
      "main": [
        [
          {
            "node": "Enviar a Obsidian Local REST API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0"
}
