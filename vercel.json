{
  "version": 3,
  "framework": null,
  "functions": {
    "server/handler.cjs": {
      "runtime": "nodejs20.x",
      "memory": 512
    }
  },
  "builds": [
    {
      "src": "server/handler.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["**/*.js", "**/*.cjs", "**/*.json", "!.git/**", "!node_modules/.cache/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.+)",
      "dest": "/server/handler.cjs",
      "methods": ["POST", "GET", "PUT", "DELETE", "PATCH"]
    },
    {
      "src": "/(.*)",
      "dest": "/server/handler.cjs"
    }
  ]
}
