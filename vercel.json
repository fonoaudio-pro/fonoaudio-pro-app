{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 9 * * *"
    }
  ],
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "esbuildOptions": {
          "external": [
            "googleapis",
            "google-auth-library",
            "@google/auth",
            "@supabase/supabase-js",
            "@google/generative-ai",
            "pdf-parse",
            "pdfjs-dist",
            "@react-pdf/*",
            "@react-pdf/renderer",
            "recharts",
            "react",
            "react-dom",
            "web-push",
            "nodemailer",
            "twilio"
          ],
          "define": { "import.meta.env": "process.env" }
        }
      }
    },
    {
      "src": "api/cron/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/cron/(.*)",
      "dest": "/api/cron/$1.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
