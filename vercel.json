{
  "version": 2,
  "framework": "vite",
  "builds": [
    {
      "src": "server/handler.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/handler.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
