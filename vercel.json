{
  "version": 3,
  "framework": null,
  "functions": {
    "server/handler.cjs": {
      "runtime": "nodejs20.x",
      "memory": 512
    }
  },
  "builds": [
    {
      "src": "server/handler.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["node_modules/**", "routes/**", "services/**", "config/**", "utils/**"]
      }
    },
    {
      "src": "dist/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/handler.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}