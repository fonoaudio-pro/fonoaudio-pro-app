{
  "version": 3,
  "framework": null,
  "builds": [
    {
      "src": "api/index.cjs",
      "use": "@vercel/node",
      "config": {
        "esbuildOptions": {
          "bundle": false,
          "format": "cjs",
          "external": ["*"]
        }
      },
      "routes": [
        { "src": "/api/(.*)", "dest": "/api/index.cjs" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
